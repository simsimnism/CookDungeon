  m_text: "\uB2F9\uC2E0\uC740 \uC694\uB9AC\uC0AC\uC785\uB2C8\uB2E4.\n\uBC30\uACE0\uD508
    \uB2F9\uC2E0\uC740 \uC774 \uC232\uC5D0\uC11C \uC694\uB9AC\uB97C \uD569\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740
    \uC694\uB9AC\uB97C \uD558\uAE30 \uC704\uD55C \uBAA8\uB2E5\uBD88\uC744 \uBC1C\uACAC\uD569\uB2C8\uB2E4.\n\uBAA8\uB2E5\uBD88\uC5D0
    \uBD88\uC744 \uC9C0\uD3B4 \uC694\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uBD88\uC744
    \uC9C0\uD53C\uAC8C \uB418\uBA74 \uC2DD\uC7AC\uB8CC\uC758 \uD615\uD0DC\uB97C \uAC00\uC9C4
    \uBAAC\uC2A4\uD130\uAC00 \uB2F9\uC2E0\uC744 \uACF5\uACA9\uD574\uC635\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740
    \uBD88\uC774 \uCF1C\uC9C8 \uB54C\uAE4C\uC9C0 \uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD574\uC57C
    \uD569\uB2C8\uB2E4.\n\uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD558\uC5EC \uC5BB\uB294
    \uC7AC\uB8CC\uB85C \uC74C\uC2DD\uC744 \uB9CC\uB4E4\uC5B4\uC11C \uAC15\uD574\uC838
    \uC0B4\uC544\uB0A8\uC544\uC57C\uD569\uB2C8\uB2E4."
